# Auto-detect text files and normalize line endings
* text=auto

# Ensure HTML files use LF in the repository and on checkout
*.html text eol=lf

# You can add other extensions as needed, for example:
# *.css text eol=lf
# *.js text eol=lf

# Mark generated reports so GitHub Linguist excludes them from language stats
allure-report/** linguist-generated=true
allure-results/** linguist-generated=true
deliverables/** linguist-generated=true
reports/** linguist-generated=true
