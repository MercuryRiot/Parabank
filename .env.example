# Example environment variables (demo defaults - not secret)
# Copy this file to `.env` if you want to override defaults locally:
#   cp .env.example .env
#
# For CI: set these values as repository secrets and inject them into the
# workflow (do NOT commit real secrets into the repository).
#
# NOTE: This project targets the public ParaBank demo instance; the default
# password here is a non-secret demo value used to register test accounts.

BASE_URL=https://parabank.parasoft.com
API_BASE=https://parabank.parasoft.com/parabank/services/bank
PASSWORD=demo1234
CUSTOMER_ID=
